# Copy this file to deploy.env and fill in your server details.
# deploy.env is git-ignored — it never leaves this machine.

SSH_HOST=3.81.153.219          # server hostname or IP address
SSH_USER=ubuntu                # SSH username (EC2: ubuntu or ec2-user)
SSH_PORT=22                    # SSH port, if not the default
SSH_KEY=                       # path to a private key file; leave blank to use the SSH agent

# Absolute path to the directory the web server serves from.
# This is the web root that server-setup.sh creates.
REMOTE_PATH=/var/www/najaf.school

# Printed after a successful deploy — cosmetic only.
SITE_URL=https://www.najaf.school
